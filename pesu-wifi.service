[Unit]
Description=PESU WiFi Login Manager & Keepalive Watchdog Daemon
After=network-online.target NetworkManager.service
Wants=network-online.target NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/bin/pesu-wifi daemon
Restart=always
RestartSec=5
StandardOutput=journal

[Install]
WantedBy=default.target
