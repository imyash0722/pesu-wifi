[Unit]
Description=PESU WiFi Continuous Keepalive & Auto-Login Daemon
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/pesu-wifi daemon
Restart=always
RestartSec=3

# Prevent kernel throttling or OOM freeze during power saving
Nice=-5
MemoryLow=32M
Slice=session.slice

StandardOutput=journal

[Install]
WantedBy=default.target
